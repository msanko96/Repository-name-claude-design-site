# Copy to .env and fill in. Used by Astro (build-time content fetch) and the
# Directus content scripts. DIRECTUS_TOKEN is a static token set on a Directus
# user (the bootstrap script sets it on the admin for local use).
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=replace-with-a-static-token

DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-strong-password
