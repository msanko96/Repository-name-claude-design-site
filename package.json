{
  "name": "bex-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^18.17.1 || ^20.3.0 || >=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "directus:up": "docker compose --env-file directus/.env -f directus/docker-compose.yml up -d",
    "directus:down": "docker compose --env-file directus/.env -f directus/docker-compose.yml down",
    "directus:logs": "docker compose --env-file directus/.env -f directus/docker-compose.yml logs -f directus",
    "directus:seed": "node --env-file=.env scripts/directus.mjs"
  },
  "devDependencies": {
    "astro": "^5.18.2"
  },
  "dependencies": {
    "@astrojs/netlify": "^6.6.5"
  }
}
