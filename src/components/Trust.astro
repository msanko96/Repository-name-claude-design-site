---
import { useTranslations, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<section id="trust" data-screen-label="01 Trust">
  <div class="container">
    <div class="section-head reveal">
      <div class="section-index" set:html={t("trust.idx")}></div>
      <h2 class="h2" set:html={t("trust.title")}></h2>
    </div>

    <div class="reveal grid grid-cols-4 gap-px bg-line-soft border border-line-soft rounded-3 overflow-hidden mb-8">
      <div class="p-8 bg-bg min-h-[180px] flex flex-col justify-between">
        <div class="mono text-[clamp(36px,5vw,64px)] font-medium tracking-[-0.04em] text-text leading-none" data-odo data-value="15" data-suffix="+">0</div>
        <div class="text-text-dim text-sm max-w-[22ch]" set:html={t("trust.s1.label")}></div>
      </div>
      <div class="p-8 bg-bg min-h-[180px] flex flex-col justify-between">
        <div class="mono text-[clamp(36px,5vw,64px)] font-medium tracking-[-0.04em] text-text leading-none" data-odo data-value="6" data-prefix="$" data-suffix="M+">0</div>
        <div class="text-text-dim text-sm max-w-[22ch]" set:html={t("trust.s2.label")}></div>
      </div>
      <div class="p-8 bg-bg min-h-[180px] flex flex-col justify-between">
        <div class="mono text-[clamp(36px,5vw,64px)] font-medium tracking-[-0.04em] text-text leading-none" data-odo data-value="50000" data-suffix="+" data-format="k">0</div>
        <div class="text-text-dim text-sm max-w-[22ch]" set:html={t("trust.s3.label")}></div>
      </div>
      <div class="p-8 bg-bg min-h-[180px] flex flex-col justify-between">
        <div class="mono text-[clamp(36px,5vw,64px)] font-medium tracking-[-0.04em] text-text leading-none" data-odo data-value="10" data-suffix="+">0</div>
        <div class="text-text-dim text-sm max-w-[22ch]" set:html={t("trust.s4.label")}></div>
      </div>
    </div>

    <p class="lead reveal mt-8" set:html={t("trust.desc")}></p>

    <div class="reveal mt-24">
      <div class="mb-6">
        <span class="mono-label" set:html={t("trust.voices.head")}></span>
      </div>
      <div class="grid grid-cols-2 max-[900px]:grid-cols-1 gap-4 max-w-[880px]">
        <figure class="relative m-0 p-8 border border-line-soft rounded-3 bg-bg-elev flex flex-col gap-4 before:content-['”'] before:absolute before:top-[14px] before:right-5 before:text-[56px] before:leading-none before:text-accent before:opacity-20 before:[font-family:Georgia,serif]">
          <a class="block w-[52px] h-[52px] self-start rounded-full" href="https://www.linkedin.com/in/pavel-lappo/" target="_blank" rel="noopener noreferrer" aria-label={t("trust.v1.who")}>
            <img class="block w-[52px] h-[52px] rounded-full border border-line bg-bg-elev object-cover shrink-0 [filter:saturate(0.92)_contrast(1.02)]" alt="" loading="lazy" src="/voices/pavel-lappo.jpg" />
          </a>
          <blockquote class="m-0 text-[15px] leading-[1.55] text-text" set:html={t("trust.v1.q")}></blockquote>
          <figcaption class="flex flex-col gap-0.5 pt-3 border-t border-line-soft mt-auto min-h-[62px]">
            <a class="font-medium text-sm text-text no-underline hover:text-accent hover:underline [transition:color_var(--dur-fast)]" href="https://www.linkedin.com/in/pavel-lappo/" target="_blank" rel="noopener noreferrer" set:html={t("trust.v1.who")}></a>
            <span class="text-text-mute text-xs font-mono leading-[1.45]" set:html={t("trust.v1.role")}></span>
          </figcaption>
        </figure>
        <figure class="relative m-0 p-8 border border-line-soft rounded-3 bg-bg-elev flex flex-col gap-4 before:content-['”'] before:absolute before:top-[14px] before:right-5 before:text-[56px] before:leading-none before:text-accent before:opacity-20 before:[font-family:Georgia,serif]">
          <a class="block w-[52px] h-[52px] self-start rounded-full" href="https://www.linkedin.com/in/lautsevich/" target="_blank" rel="noopener noreferrer" aria-label={t("trust.v2.who")}>
            <img class="block w-[52px] h-[52px] rounded-full border border-line bg-bg-elev object-cover shrink-0 [filter:saturate(0.92)_contrast(1.02)]" alt="" loading="lazy" src="/voices/pavel-lautsevich.jpg" />
          </a>
          <blockquote class="m-0 text-[15px] leading-[1.55] text-text" set:html={t("trust.v2.q")}></blockquote>
          <figcaption class="flex flex-col gap-0.5 pt-3 border-t border-line-soft mt-auto min-h-[62px]">
            <a class="font-medium text-sm text-text no-underline hover:text-accent hover:underline [transition:color_var(--dur-fast)]" href="https://www.linkedin.com/in/lautsevich/" target="_blank" rel="noopener noreferrer" set:html={t("trust.v2.who")}></a>
            <span class="text-text-mute text-xs font-mono leading-[1.45]" set:html={t("trust.v2.role")}></span>
          </figcaption>
        </figure>
        <figure class="relative m-0 p-8 border border-line-soft rounded-3 bg-bg-elev flex flex-col gap-4 before:content-['”'] before:absolute before:top-[14px] before:right-5 before:text-[56px] before:leading-none before:text-accent before:opacity-20 before:[font-family:Georgia,serif]">
          <a class="block w-[52px] h-[52px] self-start rounded-full" href="https://www.linkedin.com/in/yanakishko/" target="_blank" rel="noopener noreferrer" aria-label={t("aud.t1.who")}>
            <img class="block w-[52px] h-[52px] rounded-full border border-line bg-bg-elev object-cover shrink-0 [filter:saturate(0.92)_contrast(1.02)]" alt="" loading="lazy" src="/voices/yana-kishko.jpg" />
          </a>
          <blockquote class="m-0 text-[15px] leading-[1.55] text-text" set:html={t("aud.t1.q")}></blockquote>
          <figcaption class="flex flex-col gap-0.5 pt-3 border-t border-line-soft mt-auto min-h-[62px]">
            <a class="font-medium text-sm text-text no-underline hover:text-accent hover:underline [transition:color_var(--dur-fast)]" href="https://www.linkedin.com/in/yanakishko/" target="_blank" rel="noopener noreferrer" set:html={t("aud.t1.who")}></a>
            <span class="text-text-mute text-xs font-mono leading-[1.45]" set:html={t("aud.t1.role")}></span>
          </figcaption>
        </figure>
        <figure class="relative m-0 p-8 border border-line-soft rounded-3 bg-bg-elev flex flex-col gap-4 before:content-['”'] before:absolute before:top-[14px] before:right-5 before:text-[56px] before:leading-none before:text-accent before:opacity-20 before:[font-family:Georgia,serif]">
          <a class="block w-[52px] h-[52px] self-start rounded-full" href="https://www.linkedin.com/in/natalliaremarchuk/" target="_blank" rel="noopener noreferrer" aria-label={t("aud.t2.who")}>
            <img class="block w-[52px] h-[52px] rounded-full border border-line bg-bg-elev object-cover shrink-0 [filter:saturate(0.92)_contrast(1.02)]" alt="" loading="lazy" src="/voices/natalia-remarchuk.webp" />
          </a>
          <blockquote class="m-0 text-[15px] leading-[1.55] text-text" set:html={t("aud.t2.q")}></blockquote>
          <figcaption class="flex flex-col gap-0.5 pt-3 border-t border-line-soft mt-auto min-h-[62px]">
            <a class="font-medium text-sm text-text no-underline hover:text-accent hover:underline [transition:color_var(--dur-fast)]" href="https://www.linkedin.com/in/natalliaremarchuk/" target="_blank" rel="noopener noreferrer" set:html={t("aud.t2.who")}></a>
            <span class="text-text-mute text-xs font-mono leading-[1.45]" set:html={t("aud.t2.role")}></span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
