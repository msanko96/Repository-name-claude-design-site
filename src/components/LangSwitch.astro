---
import { altLangPath, type Lang } from "../i18n/utils";
const { lang, href: hrefProp } = Astro.props as { lang: Lang; href?: string };
const href = hrefProp ?? altLangPath(lang);
const label = lang === "en" ? "RU" : "EN";
---
<a class="lang-switch mono-label" href={href} aria-label={`Switch language to ${label}`}>{label}</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Same 40×40 / 8px box as the theme toggle (.icon-btn in components.css). */
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text-dim);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .lang-switch:hover {
    color: var(--text);
    border-color: var(--text);
  }
</style>
