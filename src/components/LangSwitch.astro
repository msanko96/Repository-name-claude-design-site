---
import { altLangPath, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
const href = altLangPath(lang);
const label = lang === "en" ? "RU" : "EN";
---
<a class="lang-switch mono-label" href={href} aria-label={`Switch language to ${label}`}>{label}</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    padding: 0 9px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--text-dim);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .lang-switch:hover {
    color: var(--text);
    border-color: var(--line-strong, var(--accent));
  }
</style>
