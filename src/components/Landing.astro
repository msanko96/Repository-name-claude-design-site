---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Trust from "./Trust.astro";
import Features from "./Features.astro";
import Inside from "./Inside.astro";
import Why from "./Why.astro";
import Audience from "./Audience.astro";
import Cta from "./Cta.astro";
import Footer from "./Footer.astro";
import type { Lang } from "../i18n/utils";

const { lang } = Astro.props as { lang: Lang };
// The landing lives at /agency, so the language switch must stay on /agency.
const altLanding = lang === "ru" ? "/agency" : "/ru/agency";
// Persona toggle destinations (current locale).
const toFreelancer = lang === "ru" ? "/ru/freelancer" : "/freelancer";
const toAgency = lang === "ru" ? "/ru/agency" : "/agency";
---
<Base lang={lang}>
  <Header lang={lang} langHref={altLanding} personaActive="agency" freelancerHref={toFreelancer} agencyHref={toAgency} demo={false} />
  <main id="top">
    <Hero lang={lang} />
    <Trust lang={lang} />
    <Features lang={lang} />
    <Inside lang={lang} />
    <Why lang={lang} />
    <Audience lang={lang} />
    <Cta lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
