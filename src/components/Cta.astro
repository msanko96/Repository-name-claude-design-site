---
import { useTranslations, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<section id="cta" class="cta" data-screen-label="06 CTA">
  <div class="grid-bg"></div>
  <div class="container cta-inner">
    <div class="cta-eyebrow mono-label"><i></i> <span set:html={t("cta.eyebrow")}></span></div>
    <h2 class="h2 cta-title" set:html={t("cta.title")}></h2>
    <p class="lead" set:html={t("cta.lead")}></p>
    <form class="cta-form" id="cta-form" novalidate>
      <input
        id="cta-email"
        name="email"
        type="email"
        required
        placeholder={t("cta.email.ph")}
        class="mono"
      />
      <button
        class="btn"
        type="submit"
        id="cta-submit"
        data-label-default={t("cta.btn")}
        data-label-loading={t("cta.btn.loading")}
        data-label-done={t("cta.btn.done")}
        data-label-error={t("cta.btn.error")}
      >
        <span class="cta-btn-label" set:html={t("cta.btn")}></span> <span class="dot"></span>
      </button>
    </form>
  </div>
</section>
