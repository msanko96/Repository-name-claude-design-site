---
import { useTranslations, type Lang } from "../i18n/utils";
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<section id="cta" class="relative overflow-hidden px-0 py-40 text-center" data-screen-label="06 CTA">
  <div class="grid-bg [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_20%,transparent_80%)]"></div>
  <div class="container relative max-w-[800px]">
    <div class="mono-label inline-flex items-center gap-1.5 text-accent mb-6"><i class="w-1.5 h-1.5 bg-accent rounded-full shadow-[0_0_10px_var(--accent)] animate-[pulse_1.6s_infinite]"></i> <span set:html={t("cta.eyebrow")}></span></div>
    <h2 class="h2 mx-auto mb-6" set:html={t("cta.title")}></h2>
    <p class="lead mx-auto mb-8" set:html={t("cta.lead")}></p>
    <form class="flex gap-2.5 justify-center max-w-[520px] mx-auto" id="cta-form" novalidate>
      <input
        id="cta-email"
        name="email"
        type="email"
        required
        placeholder={t("cta.email.ph")}
        class="mono flex-1 h-12 px-[18px] rounded-pill border border-line bg-surface text-text text-[13px] outline-none focus:border-accent disabled:opacity-55 disabled:cursor-not-allowed [transition:border-color_var(--dur-fast),opacity_var(--dur-fast)]"
      />
      <button
        class="btn disabled:opacity-55 disabled:cursor-not-allowed"
        type="submit"
        id="cta-submit"
        data-label-default={t("cta.btn")}
        data-label-loading={t("cta.btn.loading")}
        data-label-done={t("cta.btn.done")}
        data-label-error={t("cta.btn.error")}
      >
        <span class="cta-btn-label" set:html={t("cta.btn")}></span> <span class="dot"></span>
      </button>
    </form>
  </div>
</section>
