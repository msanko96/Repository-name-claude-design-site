---
import { useTranslations, type Lang } from "../i18n/utils";
import Logo from "./Logo.astro";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  lang: Lang;
  /** Hide the section nav links (used on standalone pages like /start). */
  navLinks?: boolean;
  /** Where the logo links to. Defaults to the on-page top anchor. */
  brandHref?: string;
  /** Where the "Get a demo" button links to. Defaults to the on-page CTA. */
  demoHref?: string;
  /** Override for the language switch target (defaults to the alt-locale home). */
  langHref?: string;
  /** Persona toggle: which side is the current page, plus both destinations. */
  personaActive?: "freelancer" | "agency";
  freelancerHref?: string;
  agencyHref?: string;
}

const {
  lang,
  navLinks = true,
  brandHref = "#top",
  demoHref = "#cta",
  langHref,
  personaActive,
  freelancerHref,
  agencyHref,
} = Astro.props;
const t = useTranslations(lang);

const showPersona = !!(personaActive && freelancerHref && agencyHref);
---
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={brandHref} aria-label="BENCH">
      <Logo />
    </a>

    {navLinks ? (
      <nav class="nav-links mono-label">
        <a href="#features" set:html={t("nav.features")}></a>
        <a href="#why" set:html={t("nav.why")}></a>
        <a href="#audience" set:html={t("nav.who")}></a>
      </nav>
    ) : (
      <div class="nav-spacer" aria-hidden="true"></div>
    )}

    <div class="nav-right">
      {showPersona && (
        <div class="persona-toggle" role="group" aria-label="Freelancer or agency">
          <a
            href={freelancerHref}
            class:list={["persona-opt", { "is-active": personaActive === "freelancer" }]}
            aria-current={personaActive === "freelancer" ? "page" : undefined}
            set:html={t("nav.persona.freelancer")}
          ></a>
          <a
            href={agencyHref}
            class:list={["persona-opt", { "is-active": personaActive === "agency" }]}
            aria-current={personaActive === "agency" ? "page" : undefined}
            set:html={t("nav.persona.agency")}
          ></a>
        </div>
      )}

      <button id="theme-toggle" class="icon-btn" aria-label="Toggle theme" title="Toggle theme">
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4.2"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></svg>
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      </button>
      <LangSwitch lang={lang} href={langHref} />
      <a href={demoHref} class="btn"><span set:html={t("nav.demo")}></span> <span class="dot"></span></a>
    </div>
  </div>
</header>

<style>
  /* Segmented freelancer / agency toggle — sits inline with the header controls. */
  .persona-toggle {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: var(--r-pill);
    background: color-mix(in oklch, var(--text) 5%, transparent);
    border: 1px solid var(--line-soft);
  }
  .persona-opt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 7px 13px;
    border-radius: var(--r-pill);
    color: var(--text-mute);
    white-space: nowrap;
    transition: color var(--dur-fast), background var(--dur-fast), box-shadow var(--dur-fast);
  }
  .persona-opt:hover { color: var(--text); }
  .persona-opt.is-active {
    color: var(--text);
    background: var(--bg-elev);
    box-shadow: 0 1px 2px color-mix(in oklch, var(--text) 12%, transparent);
  }

  /* Phones: tighten the toggle a touch, and push theme+lang to the right edge. */
  @media (max-width: 520px) {
    .persona-opt { padding: 6px 11px; font-size: 10px; }
    .persona-toggle { margin-right: auto; }
  }
</style>
