---
import { useTranslations, type Lang } from "../i18n/utils";
import Logo from "./Logo.astro";
import LangSwitch from "./LangSwitch.astro";

interface Props {
  lang: Lang;
  /** Hide the section nav links (used on standalone pages like /start). */
  navLinks?: boolean;
  /** Where the logo links to. Defaults to the on-page top anchor. */
  brandHref?: string;
  /** Where the "Get a demo" button links to. Defaults to the on-page CTA. */
  demoHref?: string;
  /** Hide the "Get a demo" button entirely (e.g. pages with no CTA target). */
  demo?: boolean;
  /** Override for the language switch target (defaults to the alt-locale home). */
  langHref?: string;
  /** Persona toggle: which side is the current page, plus both destinations. */
  personaActive?: "freelancer" | "agency";
  freelancerHref?: string;
  agencyHref?: string;
}

const {
  lang,
  navLinks = true,
  brandHref = "#top",
  demoHref = "#cta",
  demo = true,
  langHref,
  personaActive,
  freelancerHref,
  agencyHref,
} = Astro.props;
const t = useTranslations(lang);

const showPersona = !!(personaActive && freelancerHref && agencyHref);

// Segmented freelancer / agency toggle option styles (was the scoped .persona-opt).
const PERSONA_OPT =
  "font-mono text-[11px] max-[520px]:text-[10px] tracking-[0.04em] uppercase px-[13px] py-[7px] max-[520px]:px-[11px] max-[520px]:py-[6px] rounded-pill whitespace-nowrap transition-[color,background,box-shadow] duration-[var(--dur-fast)]";
const PERSONA_OPT_IDLE = "text-text-mute hover:text-text";
const PERSONA_OPT_ACTIVE =
  "text-text bg-bg-elev shadow-[0_1px_2px_color-mix(in_oklch,var(--text)_12%,transparent)]";
---
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href={brandHref} aria-label="BENCH">
      <Logo />
    </a>

    {navLinks ? (
      <nav class="nav-links mono-label">
        <a href="#features" set:html={t("nav.features")}></a>
        <a href="#why" set:html={t("nav.why")}></a>
        <a href="#audience" set:html={t("nav.who")}></a>
      </nav>
    ) : (
      <div class="nav-spacer" aria-hidden="true"></div>
    )}

    <div class="nav-right">
      {showPersona && (
        <div
          class="inline-flex items-center gap-0.5 p-[3px] rounded-pill border border-line-soft bg-[color-mix(in_oklch,var(--text)_5%,transparent)] max-[520px]:mr-auto"
          role="group"
          aria-label="Freelancer or agency"
        >
          <a
            href={freelancerHref}
            class:list={[PERSONA_OPT, personaActive === "freelancer" ? PERSONA_OPT_ACTIVE : PERSONA_OPT_IDLE]}
            aria-current={personaActive === "freelancer" ? "page" : undefined}
            set:html={t("nav.persona.freelancer")}
          ></a>
          <a
            href={agencyHref}
            class:list={[PERSONA_OPT, personaActive === "agency" ? PERSONA_OPT_ACTIVE : PERSONA_OPT_IDLE]}
            aria-current={personaActive === "agency" ? "page" : undefined}
            set:html={t("nav.persona.agency")}
          ></a>
        </div>
      )}

      <button id="theme-toggle" class="icon-btn" aria-label="Toggle theme" title="Toggle theme">
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4.2"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></svg>
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      </button>
      <LangSwitch lang={lang} href={langHref} />
      {demo && <a href={demoHref} class="btn"><span set:html={t("nav.demo")}></span> <span class="dot"></span></a>}
    </div>
  </div>
</header>
