---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import { useTranslations, type Lang } from "../i18n/utils";

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

// Logo → marketing landing (/agency); demo button → its CTA.
const siteLanding = lang === "en" ? "/en/agency" : "/agency";
const demoHref = lang === "en" ? "/en/agency#cta" : "/agency#cta";

// Card destinations: freelancer → persona page, agency → marketing landing.
const freelancerHref = lang === "en" ? "/en/freelancer" : "/freelancer";
const agencyHref = siteLanding;
const agencyExternal = /^https?:\/\//.test(agencyHref);
---
<Base lang={lang} titleKey="entry.page.title">
  <Header
    lang={lang}
    navLinks={false}
    brandHref={siteLanding}
    demoHref={demoHref}
  />

  <main id="top" class="gate-page">
    <div class="grid-bg"></div>
    <div class="container gate">
      <div class="gate-eyebrow mono-label"><i></i> <span set:html={t("entry.meta")}></span></div>

      <h1 class="gate-title">BEX</h1>
      <p class="gate-sub mono-label" set:html={t("entry.sub")}></p>

      <div class="gate-tree">
        <span class="gate-node" aria-hidden="true"></span>
        <svg class="gate-branches" viewBox="0 0 100 64" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <!-- Accent at the node, fading into the regular line colour at the cards. -->
            <linearGradient id="gate-branch-grad" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="64">
              <stop offset="0" style="stop-color: var(--accent); stop-opacity: 0.55" />
              <stop offset="1" style="stop-color: var(--line)" />
            </linearGradient>
          </defs>
          <path class="gate-branch gate-branch-l" d="M50 0 C50 42 24 22 24 64" fill="none" stroke="url(#gate-branch-grad)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
          <path class="gate-branch gate-branch-r" d="M50 0 C50 42 76 22 76 64" fill="none" stroke="url(#gate-branch-grad)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>

        <div class="gate-cards">
          <a class="gate-card" href={freelancerHref}>
            <span class="gate-ico" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="3.4"/>
                <path d="M5.5 19a6.5 6.5 0 0 1 13 0"/>
              </svg>
            </span>
            <span class="gate-card-title" set:html={t("entry.freelancer")}></span>
            <span class="gate-card-hint" set:html={t("entry.freelancer.hint")}></span>
          </a>

          <a
            class="gate-card"
            href={agencyHref}
            rel={agencyExternal ? "noopener noreferrer" : undefined}
          >
            <span class="gate-ico" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9.5" y="3" width="5" height="5" rx="1"/>
                <rect x="3" y="16" width="5" height="5" rx="1"/>
                <rect x="16" y="16" width="5" height="5" rx="1"/>
                <path d="M12 8v3M12 11H5.5v5M12 11h6.5v5"/>
              </svg>
            </span>
            <span class="gate-card-title" set:html={t("entry.agency")}></span>
            <span class="gate-card-hint" set:html={t("entry.agency.hint")}></span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <style>
    .gate-page {
      position: relative;
      min-height: calc(100vh - 72px);
      display: flex;
      align-items: center;
      overflow: hidden;
    }
    .gate {
      position: relative;
      z-index: 1;
      text-align: center;
      padding: clamp(40px, 8vh, 110px) 0;
    }
    .gate-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--accent-text);
      margin-bottom: var(--s-4);
    }
    .gate-eyebrow i {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 10px var(--accent);
      animation: pulse 1.6s infinite;
    }
    .gate-title {
      margin: 0;
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: clamp(64px, 12vw, 132px);
      /* Tighter than 1 so eyebrow / subtitle sit close to the glyphs,
         not to the empty line box around them. */
      line-height: 0.9;
      letter-spacing: -0.025em;
      color: var(--text);
    }
    .gate-sub {
      margin: var(--s-3) auto 0;
      font-size: 12px;
      color: var(--text-dim);
      letter-spacing: 0.12em;
    }
    /* Brand block (eyebrow + title + subtitle) is kept tight; this gap is the
       only larger one and separates it from the choice block below. */
    .gate-tree {
      position: relative;
      max-width: 680px;
      margin: clamp(28px, 4.5vh, 48px) auto 0;
    }
    .gate-node {
      display: block;
      width: 18px;
      height: 18px;
      margin: 0 auto;
      border-radius: 5px;
      background: var(--accent);
      box-shadow: 0 0 18px var(--accent-glow);
      position: relative;
      z-index: 2;
    }
    .gate-branches {
      display: block;
      width: 100%;
      height: 48px;
      margin-top: -2px;
    }
    /* Hovering / focusing a card lights up the branch leading to it. */
    .gate-tree:has(.gate-card:first-child:hover, .gate-card:first-child:focus-visible) .gate-branch-l,
    .gate-tree:has(.gate-card:last-child:hover, .gate-card:last-child:focus-visible) .gate-branch-r {
      stroke: var(--accent);
    }
    .gate-cards {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--s-6);
    }
    .gate-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      min-height: 200px;
      padding: 40px var(--s-6);
      background: color-mix(in oklch, var(--surface) 48%, transparent);
      border: 1px solid color-mix(in oklch, var(--accent) 22%, var(--line));
      border-radius: var(--r-3);
      color: var(--text);
      text-decoration: none;
      transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }
    .gate-card:hover,
    .gate-card:focus-visible {
      border-color: var(--accent);
      transform: translateY(-3px);
      background: color-mix(in oklch, var(--accent-glow) 10%, var(--surface));
      box-shadow: 0 18px 40px -16px var(--accent-glow);
    }
    .gate-card:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
    /* Light theme: white cards lifted off the page instead of grey tiles. */
    :global(:root[data-theme="light"]) .gate-card {
      background: rgb(255 255 255 / 0.4);
      border-color: color-mix(in oklch, var(--accent) 14%, var(--line));
      box-shadow: 0 1px 2px rgb(15 23 42 / 0.04), 0 10px 28px -18px rgb(15 23 42 / 0.2);
    }
    :global(:root[data-theme="light"]) .gate-card:hover,
    :global(:root[data-theme="light"]) .gate-card:focus-visible {
      border-color: var(--accent);
      background: color-mix(in oklch, var(--accent-glow) 6%, #fff);
      box-shadow: 0 18px 40px -16px var(--accent-glow);
    }
    /* Neutral grey icon tile at rest; turns accent blue with the card on
       hover / focus (lighter --accent-2 in the dark theme so it reads). */
    .gate-ico {
      display: inline-grid;
      place-items: center;
      width: 56px;
      height: 56px;
      border-radius: 14px;
      color: var(--text-dim);
      background: var(--surface-2);
      transition: background 0.2s ease, color 0.2s ease;
    }
    .gate-ico svg { width: 30px; height: 30px; }
    .gate-card:hover .gate-ico,
    .gate-card:focus-visible .gate-ico {
      color: var(--accent-2, var(--accent));
      background: color-mix(in oklch, var(--accent) 22%, var(--surface));
    }
    :global(:root[data-theme="light"]) .gate-card:hover .gate-ico,
    :global(:root[data-theme="light"]) .gate-card:focus-visible .gate-ico {
      color: var(--accent);
      background: color-mix(in oklch, var(--accent) 10%, #fff);
    }
    .gate-card-title {
      font-size: 24px;
      font-weight: 600;
      line-height: 1.2;
    }
    /* Pulled up against the card gap so title + hint read as one unit
       (icon → title keeps the full gap). */
    .gate-card-hint {
      margin-top: -8px;
      font-size: 14px;
      color: var(--text-mute);
      letter-spacing: 0.04em;
    }
    /* Phones: keep the two cards side by side with the connector lines,
       just scaled down to fit. */
    @media (max-width: 560px) {
      .gate-sub { font-size: 11px; letter-spacing: 0.06em; }
      .gate-tree { padding: 0 12px; }
      .gate-cards { gap: 10px; }
      .gate-branches { height: 32px; }
      /* Top-aligned so icons and titles line up even when a hint wraps. */
      .gate-card {
        justify-content: flex-start;
        min-height: 0;
        padding: 24px 12px;
        gap: 10px;
      }
      .gate-ico { width: 44px; height: 44px; border-radius: 12px; }
      .gate-ico svg { width: 24px; height: 24px; }
      .gate-card-title { font-size: 16px; }
      .gate-card-hint { margin-top: -4px; font-size: 11px; letter-spacing: 0.04em; }
    }
  </style>
</Base>
