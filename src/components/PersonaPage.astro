---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import { getPersona, type Persona } from "../content/personas";
import type { Lang } from "../i18n/utils";

const { lang, persona } = Astro.props as { lang: Lang; persona: Persona };
const c = getPersona(persona, lang);

const home = lang === "en" ? "/en/" : "/";
const altPath = lang === "en" ? `/${persona}` : `/en/${persona}`;
const titleKey = persona === "agency" ? "entry.page.title" : "entry.page.title";
---
<Base lang={lang} titleKey={titleKey}>
  <Header lang={lang} navLinks={false} brandHref={home} demoHref="#apply" langHref={altPath} />

  <main id="top" class="persona">
    <!-- HERO -->
    <section class="pp-hero">
      <div class="container pp-hero-grid">
        <div class="pp-hero-text reveal">
          <span class="pp-pill"><i></i> {c.pill}</span>
          <h1 class="pp-title" set:html={c.title}></h1>
          <p class="pp-sub" set:html={c.sub}></p>
          <a href="#apply" class="pp-btn pp-btn-lg">{c.cta}</a>
        </div>

        <div class="pp-hero-viz reveal" style="transition-delay:120ms">
          <div class="pp-card pp-score">
            <div class="pp-card-head">
              <span class="pp-card-label">Скоринг вакансий · LIVE</span>
              <span class="pp-badge pp-badge-green">4 подходят сегодня</span>
            </div>
            <div class="pp-rows">
              <div class="pp-row">
                <div class="pp-row-main">
                  <div class="pp-row-title">Senior React Dev · B2B SaaS Das…</div>
                  <div class="pp-row-meta">$4 000 · фикс · 🇦🇺 · 3ч назад</div>
                </div>
                <div class="pp-bar"><i style="width:91%;background:var(--pp-good)"></i></div>
                <span class="pp-pct">91%</span>
              </div>
              <div class="pp-row">
                <div class="pp-row-main">
                  <div class="pp-row-title">Webflow → Next.js migration · Sa…</div>
                  <div class="pp-row-meta">$6 000 · фикс · 🇺🇸 · 2ч назад</div>
                </div>
                <div class="pp-bar"><i style="width:78%;background:var(--accent)"></i></div>
                <span class="pp-pct">78%</span>
              </div>
              <div class="pp-row">
                <div class="pp-row-main">
                  <div class="pp-row-title">Simple WordPress landing, quick</div>
                  <div class="pp-row-meta">$500 · фикс · 🇨🇦 · 1д назад</div>
                </div>
                <div class="pp-bar"><i style="width:32%;background:var(--text-mute)"></i></div>
                <span class="pp-pct pp-pct-dim">32%</span>
              </div>
            </div>
          </div>

          <div class="pp-card pp-notify">
            <div class="pp-card-head">
              <span class="pp-card-label">Уведомления</span>
              <span class="pp-badge pp-badge-accent">2 новых</span>
            </div>
            <div class="pp-notif">
              <span class="pp-notif-ico">✓</span>
              <div class="pp-notif-main">
                <div class="pp-notif-top">
                  <b>Черновик отклика готов</b>
                  <span class="pp-notif-time">12:25</span>
                </div>
                <div class="pp-notif-desc">B2B SaaS Dashboard · React / TypeScript</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="pp-benefits">
      <div class="container">
        <div class="pp-eyebrow">{c.benefitsEyebrow}</div>
        <div class="pp-benefit-grid">
          {c.benefits.map((b, i) => (
            <div class="pp-benefit reveal" style={`transition-delay:${i * 90}ms`}>
              <span class="pp-benefit-ico">{b.icon}</span>
              <h3>{b.title}</h3>
              <p>{b.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section class="pp-pricing">
      <div class="container">
        <div class="pp-price-card reveal">
          <div class="pp-price-label">{c.price.label}</div>
          <p class="pp-price-tagline">{c.price.tagline}</p>
          <div class="pp-price-amount">
            <span class="pp-price-num">{c.price.amount}</span>
            {c.price.per && <span class="pp-price-per">{c.price.per}</span>}
          </div>
          <div class="pp-price-note">{c.price.note}</div>
          <div class="pp-price-divider"></div>
          <ul class="pp-price-features">
            {c.price.features.map((f) => (
              <li><span class="pp-check">✓</span> {f}</li>
            ))}
          </ul>
          <a href="#apply" class="pp-btn pp-btn-block">{c.price.cta}</a>
        </div>
      </div>
    </section>

    <!-- APPLY FORM -->
    <section id="apply" class="pp-apply">
      <div class="container pp-apply-inner reveal">
        <h2 class="pp-apply-title">{c.form.heading}</h2>
        <p class="pp-apply-sub">{c.form.sub}</p>
        <form
          class="pp-form"
          id="persona-form"
          data-persona={persona}
          novalidate
        >
          {c.form.fields.map((f) => (
            <input
              class="pp-input"
              name={f.name}
              type={f.type}
              placeholder={f.placeholder}
              required={f.required}
            />
          ))}
          <button
            class="pp-btn pp-btn-block pp-submit"
            type="submit"
            data-label-default={c.form.submit}
            data-label-loading={c.form.loading}
            data-label-done={c.form.done}
            data-label-error={c.form.error}
          >
            <span class="pp-submit-label">{c.form.submit}</span>
          </button>
        </form>
      </div>
    </section>
  </main>

  <style>
    .persona { --pp-good: #34d39e; }

    /* ---- Hero ---- */
    .pp-hero { padding: clamp(48px, 8vh, 110px) 0 clamp(40px, 6vh, 80px); }
    .pp-hero-grid {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      gap: clamp(32px, 5vw, 72px);
      align-items: center;
    }
    .pp-pill {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 7px 14px; border-radius: var(--r-pill);
      border: 1px solid color-mix(in oklch, var(--accent) 40%, var(--line));
      background: color-mix(in oklch, var(--accent-glow) 12%, transparent);
      color: var(--text); font-size: 13px; font-weight: 600;
    }
    .pp-pill i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
    .pp-title {
      margin: 22px 0 0;
      font-size: clamp(40px, 5.4vw, 68px); line-height: 1.02;
      letter-spacing: -0.02em; font-weight: 700; color: var(--text);
    }
    .pp-sub { margin: 22px 0 0; max-width: 46ch; color: var(--text-dim); font-size: clamp(16px, 1.2vw, 19px); line-height: 1.6; }
    .pp-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: var(--accent); color: #fff; font-weight: 700;
      border-radius: var(--r-2); text-decoration: none;
      transition: filter 0.18s ease, transform 0.18s ease;
    }
    .pp-btn:hover { filter: brightness(1.08); transform: translateY(-1px); }
    .pp-btn-lg { margin-top: 30px; padding: 15px 26px; font-size: 16px; }
    .pp-btn-block { width: 100%; padding: 16px; font-size: 16px; }

    /* ---- Hero viz cards ---- */
    .pp-hero-viz { display: flex; flex-direction: column; gap: 16px; }
    .pp-card { background: var(--bg-elev); border: 1px solid var(--line); border-radius: var(--r-4); padding: 20px; }
    .pp-card-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
    .pp-card-label { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-mute); }
    .pp-badge { font-size: 11px; font-weight: 600; padding: 4px 9px; border-radius: var(--r-pill); }
    .pp-badge-green { color: var(--pp-good); background: color-mix(in oklch, var(--pp-good) 16%, transparent); }
    .pp-badge-accent { color: var(--accent); background: color-mix(in oklch, var(--accent-glow) 18%, transparent); }
    .pp-rows { display: flex; flex-direction: column; gap: 14px; }
    .pp-row { display: grid; grid-template-columns: 1fr 90px auto; align-items: center; gap: 12px; }
    .pp-row-main { min-width: 0; }
    .pp-row-title { color: var(--text); font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pp-row-meta { color: var(--text-mute); font-size: 12px; margin-top: 3px; }
    .pp-bar { height: 6px; border-radius: 99px; background: var(--line); overflow: hidden; }
    .pp-bar i { display: block; height: 100%; border-radius: 99px; }
    .pp-pct { font-size: 14px; font-weight: 700; color: var(--pp-good); min-width: 34px; text-align: right; font-variant-numeric: tabular-nums; }
    .pp-pct-dim { color: var(--text-mute); }
    .pp-notify .pp-notif { display: flex; gap: 12px; align-items: flex-start; }
    .pp-notif-ico { flex: none; width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center; color: var(--pp-good); background: color-mix(in oklch, var(--pp-good) 16%, transparent); font-size: 13px; }
    .pp-notif-main { flex: 1; min-width: 0; }
    .pp-notif-top { display: flex; justify-content: space-between; gap: 8px; }
    .pp-notif-top b { color: var(--text); font-size: 14px; }
    .pp-notif-time { color: var(--text-mute); font-size: 12px; }
    .pp-notif-desc { color: var(--text-mute); font-size: 12px; margin-top: 3px; }

    /* ---- Benefits ---- */
    .pp-benefits { padding: clamp(30px, 5vh, 60px) 0; }
    .pp-eyebrow { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-mute); margin-bottom: 22px; }
    .pp-benefit-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .pp-benefit { background: var(--bg-elev); border: 1px solid var(--line); border-radius: var(--r-4); padding: 26px; }
    .pp-benefit-ico { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; font-size: 20px; background: color-mix(in oklch, var(--accent-glow) 14%, var(--bg)); margin-bottom: 18px; }
    .pp-benefit h3 { margin: 0 0 8px; font-size: 18px; font-weight: 700; color: var(--text); }
    .pp-benefit p { margin: 0; color: var(--text-dim); font-size: 14px; line-height: 1.55; }

    /* ---- Pricing ---- */
    .pp-pricing { padding: clamp(30px, 5vh, 60px) 0; }
    .pp-price-card { max-width: 560px; margin: 0 auto; background: var(--bg-elev); border: 1px solid color-mix(in oklch, var(--accent) 30%, var(--line)); border-radius: var(--r-4); padding: clamp(28px, 4vw, 44px); }
    .pp-price-label { color: var(--accent); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 13px; }
    .pp-price-tagline { margin: 12px 0 0; color: var(--text-dim); line-height: 1.55; }
    .pp-price-amount { display: flex; align-items: baseline; gap: 8px; margin-top: 26px; }
    .pp-price-num { font-size: clamp(40px, 5vw, 56px); font-weight: 700; color: var(--text); line-height: 1; }
    .pp-price-per { color: var(--text-mute); font-size: 16px; }
    .pp-price-note { margin-top: 8px; color: var(--text-mute); font-size: 12px; }
    .pp-price-divider { height: 1px; background: var(--line); margin: 22px 0; }
    .pp-price-features { list-style: none; margin: 0 0 26px; padding: 0; display: flex; flex-direction: column; gap: 13px; }
    .pp-price-features li { display: flex; align-items: flex-start; gap: 10px; color: var(--text-dim); font-size: 15px; }
    .pp-check { color: var(--pp-good); font-weight: 700; }

    /* ---- Apply form ---- */
    .pp-apply { padding: clamp(40px, 7vh, 90px) 0 clamp(60px, 10vh, 120px); }
    .pp-apply-inner { max-width: 860px; text-align: center; }
    .pp-apply-title { font-size: clamp(30px, 4vw, 46px); font-weight: 700; color: var(--text); margin: 0; }
    .pp-apply-sub { margin: 14px auto 34px; color: var(--text-dim); max-width: 54ch; line-height: 1.55; }
    .pp-form { display: flex; flex-direction: column; gap: 12px; text-align: left; }
    .pp-input { width: 100%; height: 52px; padding: 0 18px; background: var(--bg-elev); border: 1px solid var(--line); border-radius: var(--r-2); color: var(--text); font: inherit; transition: border-color 0.18s ease; }
    .pp-input::placeholder { color: var(--text-mute); }
    .pp-input:focus { outline: none; border-color: var(--accent); }
    .pp-submit { margin-top: 6px; border: 0; cursor: pointer; }
    .pp-submit[disabled] { opacity: 0.7; cursor: default; }

    @media (max-width: 900px) {
      .pp-hero-grid { grid-template-columns: 1fr; }
      .pp-benefit-grid { grid-template-columns: 1fr; }
    }
  </style>
</Base>
