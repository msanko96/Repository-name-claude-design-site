---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import DemoOnboarding from "./DemoOnboarding.tsx";
import { getPersona, type Persona } from "../content/personas";
import { useTranslations, type Lang } from "../i18n/utils";

const { lang, persona } = Astro.props as { lang: Lang; persona: Persona };
const c = getPersona(persona, lang);
const t = useTranslations(lang);

const home = lang === "ru" ? "/ru/" : "/";
const altPath = lang === "ru" ? `/${persona}` : `/ru/${persona}`;
const titleKey = "entry.page.title";

// Persona toggle destinations (current locale).
const toFreelancer = lang === "ru" ? "/ru/freelancer" : "/freelancer";
const toAgency = lang === "ru" ? "/ru/agency" : "/agency";
---
<Base lang={lang} titleKey={titleKey}>
  <Header lang={lang} navLinks={false} brandHref={home} demo={false} langHref={altPath} personaActive={persona} freelancerHref={toFreelancer} agencyHref={toAgency} />

  <main id="top" style="--pp-good:#34d39e">
    <!-- HERO -->
    <section class="relative overflow-hidden px-0 pt-[calc(var(--s-10)_+_20px)] pb-[clamp(40px,6vh,80px)]">
      <div class="grid-bg"></div>
      <div class="hero-scan" aria-hidden="true"></div>
      <div class="container relative z-[1] grid grid-cols-[1.05fr_1fr] max-[900px]:grid-cols-1 gap-[clamp(32px,5vw,72px)] items-center">
        <div class="reveal">
          <div class="hero-meta mono-label">
            <span set:html={t("hero.meta.engine")}></span>
            <span class="sep">-</span>
            <span class="live"><i></i><span set:html={t("hero.meta.live")}></span></span>
          </div>
          <h1 class="h1 pp-title mt-[22px] text-text" set:html={c.title}></h1>
          <p class="mt-[22px] max-w-[46ch] text-text-dim text-[clamp(16px,1.2vw,19px)] leading-[1.6]" set:html={c.sub}></p>
        </div>

        <div class="reveal flex flex-col gap-4" style="transition-delay:120ms">
          <div class="bg-bg-elev border border-line rounded-4 p-5">
            <div class="flex items-center justify-between mb-4">
              <span class="text-[11px] tracking-[0.1em] uppercase text-text-mute">{t("pp.viz.scoreLabel")}</span>
              <span class="text-[11px] font-semibold px-[9px] py-1 rounded-pill text-[var(--pp-good)] bg-[color-mix(in_oklch,var(--pp-good)_16%,transparent)]">{t("pp.viz.scoreBadge")}</span>
            </div>
            <div class="flex flex-col gap-[14px]">
              <div class="grid grid-cols-[1fr_90px_auto] max-[560px]:grid-cols-[1fr_auto] items-center gap-3 max-[560px]:gap-x-3 max-[560px]:gap-y-2">
                <div class="min-w-0 max-[560px]:col-span-full">
                  <div class="text-text text-sm font-semibold whitespace-nowrap max-[560px]:whitespace-normal overflow-hidden text-ellipsis">Senior React Dev · B2B SaaS Das…</div>
                  <div class="text-text-mute text-xs mt-[3px]">{t("pp.viz.row1.meta")}</div>
                </div>
                <div class="h-1.5 rounded-[99px] bg-line overflow-hidden max-[560px]:col-start-1 max-[560px]:self-center"><i class="block h-full rounded-[99px]" style="width:91%;background:var(--pp-good)"></i></div>
                <span class="text-sm font-bold text-[var(--pp-good)] min-w-[34px] text-right tabular-nums max-[560px]:col-start-2">91%</span>
              </div>
              <div class="grid grid-cols-[1fr_90px_auto] max-[560px]:grid-cols-[1fr_auto] items-center gap-3 max-[560px]:gap-x-3 max-[560px]:gap-y-2">
                <div class="min-w-0 max-[560px]:col-span-full">
                  <div class="text-text text-sm font-semibold whitespace-nowrap max-[560px]:whitespace-normal overflow-hidden text-ellipsis">Webflow → Next.js migration · Sa…</div>
                  <div class="text-text-mute text-xs mt-[3px]">{t("pp.viz.row2.meta")}</div>
                </div>
                <div class="h-1.5 rounded-[99px] bg-line overflow-hidden max-[560px]:col-start-1 max-[560px]:self-center"><i class="block h-full rounded-[99px]" style="width:78%;background:var(--accent)"></i></div>
                <span class="text-sm font-bold text-[var(--pp-good)] min-w-[34px] text-right tabular-nums max-[560px]:col-start-2">78%</span>
              </div>
              <div class="grid grid-cols-[1fr_90px_auto] max-[560px]:grid-cols-[1fr_auto] items-center gap-3 max-[560px]:gap-x-3 max-[560px]:gap-y-2">
                <div class="min-w-0 max-[560px]:col-span-full">
                  <div class="text-text text-sm font-semibold whitespace-nowrap max-[560px]:whitespace-normal overflow-hidden text-ellipsis">Simple WordPress landing, quick</div>
                  <div class="text-text-mute text-xs mt-[3px]">{t("pp.viz.row3.meta")}</div>
                </div>
                <div class="h-1.5 rounded-[99px] bg-line overflow-hidden max-[560px]:col-start-1 max-[560px]:self-center"><i class="block h-full rounded-[99px]" style="width:32%;background:var(--text-mute)"></i></div>
                <span class="text-sm font-bold text-text-mute min-w-[34px] text-right tabular-nums max-[560px]:col-start-2">32%</span>
              </div>
            </div>
          </div>

          <div class="bg-bg-elev border border-line rounded-4 p-5">
            <div class="flex items-center justify-between mb-4">
              <span class="text-[11px] tracking-[0.1em] uppercase text-text-mute">{t("pp.viz.notifLabel")}</span>
              <span class="text-[11px] font-semibold px-[9px] py-1 rounded-pill text-accent bg-[color-mix(in_oklch,var(--accent-glow)_18%,transparent)]">{t("pp.viz.notifBadge")}</span>
            </div>
            <div class="flex gap-3 items-start">
              <span class="flex-none w-[26px] h-[26px] rounded-2 grid place-items-center text-[var(--pp-good)] bg-[color-mix(in_oklch,var(--pp-good)_16%,transparent)] text-[13px]">✓</span>
              <div class="flex-1 min-w-0">
                <div class="flex justify-between gap-2">
                  <b class="text-text text-sm">{t("pp.viz.notifTitle")}</b>
                  <span class="text-text-mute text-xs">12:25</span>
                </div>
                <div class="text-text-mute text-xs mt-[3px]">B2B SaaS Dashboard · React / TypeScript</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="px-0 py-[clamp(30px,5vh,60px)]">
      <div class="container">
        <div class="text-[11px] tracking-[0.14em] uppercase text-text-mute mb-[22px]">{c.benefitsEyebrow}</div>
        <div class="grid grid-cols-3 max-[900px]:grid-cols-1 gap-[18px]">
          {c.benefits.map((b, i) => (
            <div class="reveal bg-bg-elev border border-line rounded-4 p-[26px]" style={`transition-delay:${i * 90}ms`}>
              <span class="inline-grid place-items-center w-11 h-11 rounded-[12px] text-xl bg-[color-mix(in_oklch,var(--accent-glow)_14%,var(--bg))] mb-[18px]">{b.icon}</span>
              <h3 class="mb-2 text-lg font-bold text-text">{b.title}</h3>
              <p class="m-0 text-text-dim text-sm leading-[1.55]">{b.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section class="px-0 py-[clamp(30px,5vh,60px)]">
      <div class="container">
        <div class="reveal max-w-[560px] mx-auto bg-bg-elev border border-line rounded-4 p-[clamp(28px,4vw,44px)]">
          <div class="text-accent font-bold tracking-[0.08em] uppercase text-[13px]">{c.price.label}</div>
          <p class="mt-3 text-text-dim leading-[1.55]">{c.price.tagline}</p>
          <div class="flex items-baseline gap-2 mt-[26px]">
            <span class="text-[clamp(40px,5vw,56px)] font-bold text-text leading-none">{c.price.amount}</span>
            {c.price.per && <span class="text-text-mute text-base">{c.price.per}</span>}
          </div>
          <div class="mt-2 text-text-mute text-xs">{c.price.note}</div>
          <div class="h-px bg-line my-[22px]"></div>
          <ul class="list-none mt-0 mb-[26px] p-0 flex flex-col gap-[13px]">
            {c.price.features.map((f) => (
              <li class="flex items-start gap-[10px] text-text-dim text-[15px]"><span class="text-[var(--pp-good)] font-bold">✓</span> {f}</li>
            ))}
          </ul>
          {persona === "freelancer" && (
            <DemoOnboarding client:visible lang={lang} ctaLabel={t("pp.onboard.cta")} />
          )}
        </div>
      </div>
    </section>

  </main>

</Base>
