---
import { useTranslations, type Lang } from "../i18n/utils";
import Logo from "./Logo.astro";
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<footer class="border-t border-line-soft px-0 py-8">
  <div class="container flex justify-between items-center gap-6 flex-wrap">
    <div class="flex items-center">
      <Logo class="h-5 opacity-65" />
    </div>
    <div class="mono-label" set:html={t("foot.build")}></div>
  </div>
</footer>
